{
  "name": "html2pdf-accessible",
  "description": "Accessible PDF generation using Skia. Supports vector graphics, text selection, and screen readers.",
  "main": "lib/html2pdf-accessible.cjs.js",
  "module": "lib/html2pdf-accessible.esm.mjs",
  "typings": "lib/types/index.d.ts",
  "browser": "lib/html2pdf-accessible.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/html2pdf-accessible.esm.mjs",
      "require": "./lib/html2pdf-accessible.cjs.js"
    },
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "version": "0.1.4",
  "author": {
    "name": "pushpagarwal",
    "email": "pushp.agarwal@gmail.com",
    "url": "https://github.com/pushpagarwal"
  },
  "license": "MIT",
  "keywords": [
    "html2pdf",
    "pdf",
    "html",
    "accessibility",
    "vector pdf",
    "skia"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "lib/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "deps/canvaskit-pdf/package.json",
    "deps/canvaskit-pdf/bin/canvaskit.js",
    "deps/canvaskit-pdf/types",
    "deps/canvaskit-pdf/LICENSE",
    "deps/canvaskit-pdf/THIRD_PARTY_LICENSES.txt",
    "deps/canvaskit-pdf/provenance.json",
    "deps/canvaskit-pdf/README.md",
    "deps/canvaskit-pdf/pdf_bindings.cpp",
    "deps/canvaskit-pdf/CHROMIUM-LICENSE",
    "deps/canvaskit-pdf/chromium-license-source.json",
    "scripts/canvaskit/"
  ],
  "homepage": "https://github.com/MathiasCiarlo/html2pdf-accessible",
  "repository": {
    "type": "git",
    "url": "https://github.com/MathiasCiarlo/html2pdf-accessible.git"
  },
  "devDependencies": {
    "@napi-rs/canvas": "0.1.80",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.12",
    "@typescript-eslint/eslint-plugin": "^4.33.0",
    "@typescript-eslint/parser": "^4.33.0",
    "copy-webpack-plugin": "^13.0.0",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "4.2.1",
    "fast-xml-parser": "5.5.7",
    "husky": "^8.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.2.7",
    "mkdirp": "^3.0.1",
    "path-browserify": "^1.0.1",
    "pdfjs-dist": "5.4.296",
    "playwright": "1.63.0",
    "prettier": "^2.3.2",
    "rimraf": "^6.0.1",
    "terser-webpack-plugin": "^5.3.14",
    "ts-jest": "^29.1.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tslib": "^2.3.0",
    "typescript": "^5.5.4",
    "webpack": "^5.100.0",
    "webpack-cli": "^6.0.1"
  },
  "scripts": {
    "prebuild": "npm run verify:canvaskit && rimraf lib/ && rimraf build/ && mkdirp lib && mkdirp build",
    "build": "webpack --mode=production",
    "prepublishOnly": "npm run build",
    "build:dev": "webpack --mode=development",
    "build:watch": "webpack --mode=development --watch",
    "format": "prettier --write \"{src,tests,scripts}/**/*.ts\"",
    "lint": "eslint src tests scripts *.js --ext .ts,.js,.cjs --max-warnings 0",
    "test": "npm run unittest -- --runInBand && node --test tests/pdf/integration/*.test.cjs && npm run typecheck",
    "unittest": "jest",
    "test:pdf": "npm run build:dev && node scripts/pdf/run.cjs",
    "test:pdf:serve": "node scripts/pdf/server.cjs",
    "typecheck": "tsc --noEmit -p tests/tsconfig.json",
    "test:pdf:visual": "node scripts/pdf/visual.cjs",
    "test:pdf:validate": "node scripts/pdf/validate.cjs",
    "test:pdf:update": "node scripts/pdf/visual.cjs --update",
    "test:package": "node scripts/pdf/package.cjs",
    "lint:changed": "node scripts/lint-changed.cjs",
    "prebuild:dev": "npm run verify:canvaskit && rimraf lib/ && rimraf build/ && mkdirp lib && mkdirp build",
    "build:canvaskit": "node scripts/canvaskit/build.cjs",
    "test:canvaskit:rebuild": "node scripts/canvaskit/build.cjs --check",
    "verify:canvaskit": "node scripts/canvaskit/verify.cjs"
  },
  "dependencies": {
    "@html2pdf-skia/canvaskit-pdf": "file:deps/canvaskit-pdf",
    "@pdf-lib/fontkit": "^1.1.1",
    "@webgpu/types": "0.1.69",
    "css-line-break": "^2.1.0",
    "emoji-regex-xs": "^2.0.1",
    "pdf-lib": "^1.17.1",
    "text-segmentation": "^1.0.3"
  },
  "bundleDependencies": [
    "@html2pdf-skia/canvaskit-pdf"
  ],
  "lint-staged": {
    "{src,tests}/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
